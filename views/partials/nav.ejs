<!-- ✅ Navbar (stays at top) -->
<nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-evenly h-16 items-center">
      <!-- Logo / Brand -->
      <a href="/" class="text-2xl font-bold text-red-600">Airbnb</a>

      <!-- Navigation Links -->
      <% if(isLoggedin){ %>
        
        <div class="hidden md:flex space-x-6">
          <a href="../store/booking" class="text-gray-700 hover:text-red-600 transition">Book</a>
          <a href="../store/favourites" class="text-gray-700 hover:text-red-600 transition">Favourites</a>
          <a href="/" class="text-gray-700 hover:text-red-600 transition">Home</a>
          <a href="/home" class="text-gray-700 hover:text-red-600 transition">List Home</a>
          <a href="/store/reserves" class="text-gray-700 hover:text-red-600 transition">Reservation</a>
          
        </div>
      <% }%>

      <% if(!isLoggedin) {%>

          <a href="/signup" 
            class="ml-3 bg-red-600 text-white px-4 py-2 rounded-full hover:bg-red-700 transition shadow-md">
            signup
          </a>


        
          <a href="/login" 
            class="ml-3 bg-red-600 text-white px-4 py-2 rounded-full hover:bg-red-700 transition shadow-md">
            LOGIN
          </a>


      <% }else { %>
        <li class="list-none">

          <form action="/logout" method="post">
            <button
            type="submit"
            class=class="ml-3 bg-red-600 text-white px-4 py-2 rounded-full hover:bg-red-700 transition shadow-md"
            >logout</button>
          </form>
        </li>  
      <% } %>
    </div>
  </div>
</nav>
