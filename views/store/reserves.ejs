<%- include("../partials/head")%>
  </head>

  <body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">
    <%- include('../partials/nav') %>

    <!-- ✅ Reservations Page -->
    <main class="flex flex-col items-center justify-center text-center px-4 py-12">
      <header class="mb-10">
        <h1 class="text-4xl font-bold text-red-700 mb-2">Your Reservations</h1>
        <p class="text-gray-600 text-lg max-w-2xl">
          Here are your recent and upcoming bookings. Relax and enjoy your stay!
        </p>
      </header>

      <!-- ✅ Reservation Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl w-full">
        <!-- Card 1 -->
        <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
          <img src="/house.jpg" alt="House 1" class="w-full h-48 object-cover" />
          <div class="p-5 text-left">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Cozy Beachside Villa</h2>
            <p class="text-gray-500 mb-1">📍 Goa, India</p>
            <p class="text-gray-700 mb-1">📅 Check-in: Nov 5, 2025</p>
            <p class="text-gray-700 mb-1">📅 Check-out: Nov 10, 2025</p>
            <p class="text-gray-700 font-medium mt-2">💰 ₹7,500 / night</p>
            <p class="text-yellow-500 font-semibold mt-1">⭐ 4.8 / 5</p>
            <button class="bg-green-400 pt-2 pb-2 pl-4 pr-4 rounded-xl">book</button>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
          <img src="/house.jpg" alt="House 2" class="w-full h-48 object-cover" />
          <div class="p-5 text-left">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Mountain View Cabin</h2>
            <p class="text-gray-500 mb-1">📍 Manali, India</p>
            <p class="text-gray-700 mb-1">📅 Check-in: Dec 15, 2025</p>
            <p class="text-gray-700 mb-1">📅 Check-out: Dec 20, 2025</p>
            <p class="text-gray-700 font-medium mt-2">💰 ₹5,200 / night</p>
            <p class="text-yellow-500 font-semibold mt-1">⭐ 4.5 / 5</p>
            <button class="bg-green-400 pt-2 pb-2 pl-4 pr-4 rounded-xl">book</button>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-lg transition duration-300">
          <img src="/house.jpg" alt="House 3" class="w-full h-48 object-cover" />
          <div class="p-5 text-left">
            <h2 class="text-xl font-semibold text-gray-800 mb-1">Luxury Lake House</h2>
            <p class="text-gray-500 mb-1">📍 Nainital, India</p>
            <p class="text-gray-700 mb-1">📅 Check-in: Jan 3, 2026</p>
            <p class="text-gray-700 mb-1">📅 Check-out: Jan 8, 2026</p>
            <p class="text-gray-700 font-medium mt-2">💰 ₹9,800 / night</p>
            <p class="text-yellow-500 font-semibold mt-1">⭐ 4.9 / 5</p>
            <button class="bg-green-400 pt-2 pb-2 pl-4 pr-4 rounded-xl">book</button>
          </div>
        </div>
      </div>

      <p class="text-gray-500 mt-10">*This is a dummy reservations page. Data display coming soon!</p>
    </main>
  </body>
</html>
