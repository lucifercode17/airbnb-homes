<%- include("../partials/head")%>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-800">
    <%- include("./hostpartials/hostnav")%>
      <!-- Navbar End -->

      <!-- Main Content -->
      <main class="flex flex-col items-center justify-center px-4">
        <header class="mb-8 text-center">
          <h1 class="text-3xl font-semibold text-red-700">
            <%= editing ? "edit" :"Register" %> Your Home
          </h1>
          <p class="text-gray-600 mt-2">List your property and start earning today!</p>
        </header>

        <section class="w-full max-w-md bg-white p-6 rounded-xl shadow-lg">
          <form action="/host/<%= editing ? "edit-home" : "add-home" %>" method="POST" class="flex flex-col space-y-4"  enctype ="multipart/form-data">

            <div>
              <label for="houseName" class="block text-sm font-medium text-gray-700 mb-1">
                House Name
              </label>
              <input type="text" id="houseName" name="houseName" placeholder="Enter the name of your house"
                class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"
                required value="<%= editing ? home.houseName : "" %>" />
            </div>
            <div>
              <label for="price" class="block text-sm font-medium text-gray-700 mb-1">
                House Price
              </label>
              <input type="text" id="price" name="price" placeholder="Enter  your house price"
                class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"
                required value="<%= editing ? home.price : "" %>" />
            </div>
            <div>
              <label for="location" class="block text-sm font-medium text-gray-700 mb-1">
                House location
              </label>
              <input type="text" id="location" name="location" placeholder="Enter  your house location"
                class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"
                required value="<%= editing ? home.location : "" %>" />
            </div>
            <div>
              <label for="photo" class="block text-sm font-medium text-gray-700 mb-1">
                House photo
              </label>
            <input type="file" id="photo" name="photo" multiple 
                class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"  />
            </div>
            <div>
              <label for="rating" class="block text-sm font-medium text-gray-700 mb-1">
                House rating
              </label>
              <input type="text" id="rating" name="rating" placeholder="Enter  your house rating"
                class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"
                required value="<%= editing ? home.rating : "" %>" />
            </div>
            <div>
              <label for="description" class="block text-sm font-medium text-gray-700 mb-1">
                House description
              </label>
              <textarea id="description" name="description" placeholder="Enter your house description"
                class="w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-red-500"><%= editing ? home.description : "" %></textarea>

            </div>
            <input type="hidden" name="_id" value="<%= editing ? home._id :"" %>">

            <input type="submit" class="bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition"
              value="<%= editing ? " update" :"submit" %>">


          </form>
        </section>
      </main>
  </body>

  </html>