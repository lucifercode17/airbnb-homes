<!-- ✅ Host Navbar -->
<nav class="bg-white shadow-md sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center">

      <!-- Logo / Brand -->
      <a href="/host/host-home-list" class="text-2xl font-bold text-red-600">Airbnb Host</a>

      <!-- Navigation Links -->
      <div class="hidden md:flex space-x-6">
        <a href="/host/add-home" class="text-gray-700 hover:text-red-600 transition">Add Home</a>
        <a href="/host/host-home-list" class="text-gray-700 hover:text-red-600 transition">Home List</a>
        
      </div>

      <!-- Switch User Mode Button -->
      <% if(!isLoggedin) {%>

          <a href="/signup" 
            class="ml-3 bg-red-600 text-white px-4 py-2 rounded-full hover:bg-red-700 transition shadow-md">
            signup
          </a>


        
          <a href="/login" 
            class="ml-3 bg-red-600 text-white px-4 py-2 rounded-full hover:bg-red-700 transition shadow-md">
            LOGIN
          </a>


      <% }else { %>
        <li class="list-none">

          <form action="/logout" method="post">
            <button
            type="submit"
            class=class="ml-3 bg-red-600 text-white px-4 py-2 rounded-full hover:bg-red-700 transition shadow-md"
            >logout</button>
          </form>
        </li>  
      <% } %>
    </div>
  </div>
</nav>
